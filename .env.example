# 抓取与调度
PAGE_URL=https://api-docs.deepseek.com/zh-cn/updates
CHECK_INTERVAL_SECONDS=300
NOTIFY_ON_FIRST_RUN=true

# SMTP 邮件（四项均填写才启用）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_TO=

# 微信渠道，任选其一或同时配置
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=

# 其他可选渠道
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
BARK_KEY=
